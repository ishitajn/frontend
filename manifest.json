{
  "manifest_version": 3,
  "name": "Wingman AI",
  "version": "11.0.0",
  "description": "Context-aware AI assistant for Tinder and Bumble.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.bumble.com/*",
    "*://*.tinder.com/*",
    "http://localhost/*",
    "http://10.0.0.24/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+B",
        "mac": "Command+Shift+B"
      },
      "description": "Open Wingman"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}